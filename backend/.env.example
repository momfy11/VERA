DATABASE_URL=postgresql+psycopg2://vera:vera@localhost:5432/vera
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173

# LLM — set provider and matching API key
# Providers: mistral | groq
LLM_PROVIDER=mistral
# Mistral models: mistral-small-latest | mistral-medium-latest | open-mistral-7b
# Groq models:    llama-3.3-70b-versatile | mixtral-8x7b-32768
LLM_MODEL=mistral-small-latest
MISTRAL_API_KEY=your-mistral-api-key-here
GROQ_API_KEY=
