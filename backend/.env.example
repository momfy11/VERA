DATABASE_URL=postgresql+psycopg2://vera:vera@localhost:5432/vera
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173

# ── LLM provider ────────────────────────────────────────────────────────────
# Providers: gemini | groq | mistral | ollama
LLM_PROVIDER=gemini
# gemini models:  gemini-2.5-flash | gemini-2.0-flash | gemini-1.5-pro
# groq models:    llama-3.3-70b-versatile | mixtral-8x7b-32768
# mistral models: mistral-small-latest | mistral-medium-latest
# ollama models:  qwen2.5:7b | llama3.2:3b (local, no API key needed)
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=
MISTRAL_API_KEY=
OLLAMA_URL=http://localhost:11434

# ── Embedding provider ───────────────────────────────────────────────────────
# Providers: fastembed (local, default) | ollama (local) | openai (API)
EMBEDDING_PROVIDER=fastembed
# fastembed default: BAAI/bge-small-en-v1.5 (384 dims, ~33MB, no key needed)
# ollama default:    nomic-embed-text (768 dims, local)
# openai:            text-embedding-3-small (1536 dims, needs OPENAI_API_KEY)
EMBEDDING_MODEL=
EMBEDDING_DIM=
OPENAI_API_KEY=

# ── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production

# ── Google OAuth (Calendar + Gmail) ─────────────────────────────────────────
# Place credentials.json from Google Cloud Console in backend/credentials/
# GOOGLE_REDIRECT_URI should match your OAuth client's authorized redirect URI
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── Optional integrations ────────────────────────────────────────────────────
# Spotify (requires Premium account on the authorized device)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/auth/spotify/callback

# NewsAPI (https://newsapi.org — free tier: 100 req/day)
NEWS_API_KEY=

# Whisper model cache (server-side STT + wake word)
WHISPER_CACHE_DIR=/app/.whisper_cache

# Number of conversation turns kept in context (default 20)
LLM_HISTORY_TURNS=20
