# Frontend env vars — copy to client/.env (gitignored) and fill in.

# Backend URLs (defaults are fine for local dev on the same machine)
# VITE_API_BASE=http://localhost:8000/api
# VITE_WS_BASE=ws://localhost:8000

# When testing from a phone on the same Wi-Fi, use your laptop's LAN IP:
# VITE_API_BASE=http://192.168.1.42:8000/api
# VITE_WS_BASE=ws://192.168.1.42:8000

# When installing the PWA on phone via cloudflared/ngrok tunnel
# (see docs/MOBILE_INSTALL.md), use the HTTPS tunnel URL with wss://:
# VITE_API_BASE=https://your-tunnel.trycloudflare.com/api
# VITE_WS_BASE=wss://your-tunnel.trycloudflare.com

# ── Wake word (Web Speech API based, no signup) ────────────────────────────
# Comma-separated trigger phrases. Match is fuzzy + case-insensitive.
# Default: "hey vera,vera"
# VITE_WAKE_PHRASES=hey vera,vera,computer
