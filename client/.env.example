# Frontend env vars — copy to client/.env (gitignored) and fill in.

# Backend URLs (defaults are fine for local dev)
# VITE_API_BASE=http://localhost:8000/api
# VITE_WS_BASE=ws://localhost:8000

# ── Wake word (Picovoice Porcupine) ────────────────────────────────────────
# Get free access key at https://console.picovoice.ai
VITE_PICOVOICE_KEY=

# Built-in keyword if no custom .ppn is provided. Options:
# Alexa | Americano | Blueberry | Bumblebee | Computer | Grapefruit |
# Grasshopper | Hey Google | Hey Siri | Jarvis | Okay Google | Picovoice |
# Porcupine | Terminator
VITE_WAKE_WORD=Jarvis

# Optional custom keyword. Train "Hey VERA" at console.picovoice.ai (free for
# personal), download .ppn (Web platform), place at client/public/wake/.
# When set, this overrides VITE_WAKE_WORD.
# VITE_WAKE_WORD_PATH=/wake/hey-vera.ppn

# Path to porcupine_params.pv (English language model). Already in public/.
# VITE_WAKE_MODEL_PATH=/porcupine_params.pv
