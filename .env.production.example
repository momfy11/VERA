# Production deploy — copy to `.env` at the repo root and fill in.
# Secrets in backend/.env (mounted into the backend container via env_file).
# This root .env only holds build-time + compose-time public values.
#
# ────────────────────────────────────────────────────────────────────────────
# Domain / HTTPS
# ────────────────────────────────────────────────────────────────────────────
# Caddy auto-issues a Let's Encrypt cert for $DOMAIN via HTTP-01.
#
# If you don't own a domain yet, use a sslip.io subdomain — it resolves any
# IP without DNS configuration. Replace dots in the IP with dashes:
#   server IP = 46.225.81.127  →  DOMAIN=46-62-225-46.sslip.io
#
DOMAIN=46-62-225-46.sslip.io

# These get baked into the frontend bundle at build time. Must match $DOMAIN.
PUBLIC_API_BASE=https://46-62-225-46.sslip.io/api
PUBLIC_WS_BASE=wss://46-62-225-46.sslip.io

# CORS allowlist passed to the backend (comma-separated).
ALLOWED_ORIGINS=https://46-62-225-46.sslip.io

# Optional wake-word phrases override
VITE_WAKE_PHRASES=hey vera,vera

# ────────────────────────────────────────────────────────────────────────────
# Postgres in-container creds
# ────────────────────────────────────────────────────────────────────────────
# IMPORTANT for prod: generate a strong password (don't use the default).
#   openssl rand -hex 24
POSTGRES_USER=vera
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=vera
