# Production deploy — copy to .env (project root) and fill in.
# Secrets in backend/.env (mounted into the backend container via env_file).
# This root .env only holds the build-time + compose-time public values.

# Public domain Caddy will issue a cert for
DOMAIN=vera.example.com

# These get baked into the frontend bundle at build time
PUBLIC_API_BASE=https://vera.example.com/api
PUBLIC_WS_BASE=wss://vera.example.com

# CORS allowlist passed to backend (comma-separated)
ALLOWED_ORIGINS=https://vera.example.com

# Optional wake-word phrases override
VITE_WAKE_PHRASES=hey vera,vera

# Postgres in-container creds (only set if changing defaults)
# POSTGRES_USER=vera
# POSTGRES_PASSWORD=use-a-real-password-here
# POSTGRES_DB=vera
